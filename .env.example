# Variables para correr handlers en local con `pnpm invoke`.
# Copia a .env (ignorado por git).
AWS_REGION=us-east-1
TABLE_NAME=orderly
DYNAMODB_ENDPOINT=http://localhost:8000
EVENT_BUS_NAME=orderly-dev
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_AUTH=none
LOG_LEVEL=debug
# Credenciales falsas para que el SDK no se queje contra DynamoDB Local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
